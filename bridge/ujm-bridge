#!/usr/bin/env python3
"""UJM bridge: exposes the joystickmanager state and a few actions on D-Bus (org.ujm.Manager1).

The shell service (joystickmanager.sh) stays the only authority over LEDs and numbering. This
bridge only (1) republishes /run/joystickmanager/state.json, (2) stores aliases, and (3) drives
BlueZ (scan, pair, connect, disconnect) on behalf of the interface, with polkit authorization.

It is activated by the bus on first use and exits when no client that called it is left, so it
costs nothing while the interface is closed. See docs/bridge.md.
"""
import errno
import json
import os
import re
import sys
import time
import uuid

import gi

gi.require_version("Gio", "2.0")
gi.require_version("GLib", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

BUS_NAME = "org.ujm.Manager1"
OBJ_PATH = "/org/ujm/Manager1"
IFACE = "org.ujm.Manager1"
API_VERSION = "1"
MAC_RE = re.compile(r"^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$")  # HID "uniq" may be lower case (DualShock 3)
ALIAS_MAX = 40
IDLE_EXIT_SECONDS = int(os.environ.get("UJM_BRIDGE_IDLE_EXIT", "30"))
SCAN_MAX = 60
ACK_TIMEOUT = float(os.environ.get("UJM_ACK_TIMEOUT", "5"))

XML = """
<node>
  <interface name="org.ujm.Manager1">
    <property name="Version" type="s" access="read"/>
    <property name="StateAvailable" type="b" access="read"/>
    <property name="Controllers" type="aa{sv}" access="read"/>
    <method name="ListControllers"><arg direction="out" type="aa{sv}"/></method>
    <method name="GetController"><arg direction="in" type="s" name="id"/><arg direction="out" type="a{sv}"/></method>
    <method name="GetServiceStatus"><arg direction="out" type="a{sv}"/></method>
    <method name="GetSnapshotJson"><arg direction="out" type="s"/></method>
    <method name="SetControllerAlias"><arg direction="in" type="s" name="id"/><arg direction="in" type="s" name="alias"/></method>
    <method name="ConnectBluetooth"><arg direction="in" type="s" name="id"/></method>
    <method name="DisconnectBluetooth"><arg direction="in" type="s" name="id"/></method>
    <method name="ScanBluetooth"><arg direction="in" type="u" name="seconds"/></method>
    <method name="ListBluetoothDevices"><arg direction="out" type="aa{sv}"/></method>
    <method name="PairBluetooth"><arg direction="in" type="s" name="address"/></method>
    <method name="SetIdleTimeout"><arg direction="in" type="u" name="seconds"/></method>
    <method name="SetPlayerLeds"><arg direction="in" type="s" name="id"/><arg direction="in" type="u" name="mask"/></method>
    <method name="SetHomeLed"><arg direction="in" type="s" name="id"/><arg direction="in" type="b" name="enabled"/></method>
    <signal name="ControllersChanged"/>
