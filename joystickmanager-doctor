#!/usr/bin/env bash
# Diagnóstico de drivers: compara controllers.tsv com os módulos do kernel e
# com os controles conectados agora. Só lê o sistema; não instala nada.
# Uso: joystickmanager-doctor
set -u

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
main=
for f in "$here/joystickmanager.sh" /usr/local/bin/joystickmanager.sh /usr/bin/joystickmanager.sh; do
    [ -r "$f" ] && { main=$f; break; }
done
[ -n "$main" ] || { printf '%s\n' 'joystickmanager.sh não encontrado.' >&2; exit 1; }

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
export JOYMANAGER_RUNTIME_DIR="$tmp"
user_experimental=${JOYMANAGER_EXPERIMENTAL:-0}
# shellcheck source=joystickmanager.sh
source "$main"

table=$(profiles_path) || { printf '%s\n' 'controllers.tsv não encontrado; o serviço usa a lista fixa de controles validados.' >&2; exit 1; }

module_state() { # imprime loaded | available | absent
    local m=${1//-/_}
    if [ -d "/sys/module/$m" ]; then printf 'loaded'
    elif modinfo -n "$m" >/dev/null 2>&1; then printf 'available'
    else printf 'absent'; fi
}

bound_driver() { # primeiro ancestral com link "driver"
    local p
    p=$(readlink -f "$1/device" 2>/dev/null || true)
    while [ -n "$p" ] && [ "$p" != / ]; do
        if [ -L "$p/driver" ]; then basename "$(readlink -f "$p/driver")"; return 0; fi
        p=$(dirname "$p")
    done
    printf -- '-'
}

printf 'Tabela: %s\n' "$table"
printf 'Experimentais: %s\n\n' "$([ "$user_experimental" = 1 ] && printf ligados || printf 'desligados (JOYMANAGER_EXPERIMENTAL=1 para ligar)')"

printf '%-18s %-13s %s\n' FAMILIA ESTADO 'MÓDULOS DO KERNEL / DRIVER EXTERNO'
seen=
while IFS=$'\t' read -r fam match status bus mods ext notes; do
    case "$fam" in ''|'#'*) continue;; esac
    case " $seen " in *" $fam "*) continue;; esac
    seen="$seen $fam"
    line=
    if [ "$mods" != - ]; then
        IFS=, read -ra arr <<<"$mods"
        for m in "${arr[@]}"; do line="$line $m=$(module_state "$m")"; done
    fi
    [ "$ext" = - ] || line="$line | externo opcional: $ext"
    printf '%-18s %-13s%s\n' "$fam" "$status" "${line:- -}"
done <"$table"

printf '\nControles conectados:\n'
found=0
experimental=1   # para listar também os que o serviço ainda ignora
for p in "$sys_input"/event*; do
    [ -e "$p" ] || continue
    ev=$(basename "$p")
    row=$(profile_for_event "$ev") || continue
    fam=${row%%$'\t'*}; st=${row##*$'\t'}
    if [ "$st" = validated ] || [ "$user_experimental" = 1 ]; then act='ativo'; else act='ignorado (experimental desligado)'; fi
    printf '  %-8s %-34s perfil=%-16s estado=%-12s driver=%s  -> %s\n' "$ev" "$(read_file "$p/device/name")" "$fam" "$st" "$(bound_driver "$p")" "$act"
    found=1
done
[ "$found" = 1 ] || printf '  nenhum controle com perfil conhecido\n'

printf '\nObservação: módulos e drivers acima são o esperado, não uma garantia de compatibilidade.\n'
