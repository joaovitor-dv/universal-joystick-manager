# OPTIONAL - Pro Controller charges over USB only; the USB data is turned off.
#
# When a data cable is plugged in, hid-nintendo performs the USB handshake and the
# Pro Controller firmware abandons Bluetooth. By deauthorizing the USB device the
# controller keeps charging (cable power does not depend on the data lines) and
# returns to Bluetooth.
# Validated by hand on hardware: `echo 0 | tee /sys/bus/usb/devices/<port>/authorized`
# kept the Pro on Bluetooth with the battery reporting "Charging". This RULE itself
# has not been tested yet.
#
# Known limitations:
# - The controller stops working wired (USB) while the rule is installed.
# - Race: the kernel has already enumerated the device by the time udev runs, so the
#   controller may leave Bluetooth for a moment when the cable is plugged in. It is
#   not verified whether it comes back on its own or needs HOME to be pressed (HOME
#   was pressed in the manual tests).
# - The "authorized" attribute belongs to the device: every replug makes the kernel
#   create a new, authorized device, which is why the rule runs on every "add".
#
# Install:   sudo install -Dm644 udev/99-joystickmanager-procontroller-charge-only.rules /etc/udev/rules.d/
#            sudo udevadm control --reload
# Remove:    sudo rm /etc/udev/rules.d/99-joystickmanager-procontroller-charge-only.rules
#            sudo udevadm control --reload   (and replug the cable)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="057e", ATTR{idProduct}=="2009", ATTR{authorized}="0"
