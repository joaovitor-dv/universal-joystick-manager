# OPCIONAL — Pro Controller só carrega por USB; os dados USB ficam desligados.
#
# Ao ligar o cabo de dados, o hid-nintendo faz o handshake USB e o firmware do Pro
# Controller abandona o Bluetooth. Desautorizando o dispositivo USB, o controle
# continua carregando (a energia do cabo não depende dos dados) e volta ao Bluetooth.
# Validado à mão no hardware: `echo 0 | tee /sys/bus/usb/devices/<porta>/authorized`
# manteve o Pro em Bluetooth com bateria "Charging". Esta REGRA em si ainda não foi testada.
#
# Limitações conhecidas:
# - O controle deixa de funcionar com fio (USB) enquanto a regra estiver instalada.
# - Corrida: o kernel já enumerou o dispositivo quando o udev roda, então o controle
#   pode sair do Bluetooth por instantes ao plugar o cabo. Não verificado se volta
#   sozinho ou se precisa apertar HOME (nos testes manuais o HOME foi apertado).
# - O atributo "authorized" é do dispositivo: a cada replugada o kernel cria um novo
#   dispositivo autorizado, por isso a regra roda em todo "add".
#
# Instalar:  sudo install -Dm644 udev/99-joystickmanager-procontroller-charge-only.rules /etc/udev/rules.d/
#            sudo udevadm control --reload
# Remover:   sudo rm /etc/udev/rules.d/99-joystickmanager-procontroller-charge-only.rules
#            sudo udevadm control --reload   (e replugue o cabo)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="057e", ATTR{idProduct}=="2009", ATTR{authorized}="0"
