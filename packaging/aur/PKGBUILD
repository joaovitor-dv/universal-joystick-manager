# Maintainer: João (joaovitor-dv) <https://github.com/joaovitor-dv>
# AUR recipe: builds from the release tarball. Update it with packaging/aur/update.sh <version>.
pkgname=universal-joystick-manager
pkgver=0.8.0
pkgrel=1
pkgdesc='UJM - Universal Joystick Manager for Linux'
arch=('any')
url='https://github.com/joaovitor-dv/universal-joystick-manager'
license=('MIT')
depends=('bash' 'systemd' 'bluez' 'bluez-utils' 'evtest' 'python')
optdepends=('joycond-git: combine Nintendo Joy-Cons' 'upower: desktop battery integration')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b177522d191dda84c42d2427c78b52a1ef1fde595b84b9ebdfa66bf0e72baecd')

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 joystickmanager.sh "$pkgdir/usr/bin/joystickmanager.sh"
    install -Dm755 joystickmanager-doctor "$pkgdir/usr/bin/joystickmanager-doctor"
    install -Dm755 switchpro-leds.py "$pkgdir/usr/lib/joystickmanager/switchpro-leds"
    install -Dm644 controllers.tsv "$pkgdir/usr/share/joystickmanager/controllers.tsv"
    install -Dm644 udev/99-joystickmanager-procontroller-charge-only.rules "$pkgdir/usr/share/joystickmanager/udev/99-joystickmanager-procontroller-charge-only.rules"
    # the unit in the repository points at /usr/local (install.sh); packages install to /usr
    install -dm755 "$pkgdir/usr/lib/systemd/system"
    sed 's|/usr/local/bin/|/usr/bin/|' joystickmanager.service >"$pkgdir/usr/lib/systemd/system/joystickmanager.service"
    chmod 644 "$pkgdir/usr/lib/systemd/system/joystickmanager.service"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
