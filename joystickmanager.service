[Unit]
Description=Unified joystick player and battery manager
After=bluetooth.service
Wants=joycond.service

[Service]
ExecStart=/usr/local/bin/joystickmanager.sh
Restart=always
RestartSec=3
Environment=JOYCON_MANAGER_MAX_PLAYERS=8
Environment=JOYMANAGER_IDLE_TIMEOUT=1800

[Install]
WantedBy=default.target
