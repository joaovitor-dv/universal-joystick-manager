[Unit]
Description=Unified joystick player and battery manager
After=bluetooth.service
PartOf=bluetooth.service
Wants=joycond.service

[Service]
ExecStart=/usr/local/bin/joystickmanager.sh
Restart=always
RestartSec=3
Environment=JOYCON_MANAGER_MAX_PLAYERS=10
Environment=JOYMANAGER_IDLE_TIMEOUT=300
Environment=JOYMANAGER_LED_REFRESH=10

[Install]
WantedBy=default.target
